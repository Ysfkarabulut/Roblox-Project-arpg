function RoleArmorDefs.Build(): { [string]: any }
	local out = {}
	for _, p in PIECES do
		out[p.id] = {
			id = p.id,
			name = p.name,
			kind = p.kind,
			slotHints = p.slotHints,
			element = p.element,
			defence = p.defence,
			resist = p.resist,
			rarity = p.rarity,
			roleHint = p.roleHint,
			abilities = ArmorAbilityDefs.NormalizeAbilities(p.abilities),
			desc = p.desc,
		}
	end
	return out
end

function RoleArmorDefs.AllPieceIds(): { string }
	local ids = {}
	for _, p in PIECES do
		table.insert(ids, p.id)
	end
	table.sort(ids)
	return ids
end

return RoleArmorDefs
